generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  ADMIN
  OPERATOR
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum MaritalStatus {
  SINGLE
  MARRIED
}

enum OwnTransportType {
  INDIVIDUAL
  TAXI
}

model TransportStop {
  id           String        @id @default(cuid())
  name         String        @unique
  active       Boolean       @default(true)
  participants Participant[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("transport_stops")
}

model TentType {
  id           String        @id @default(cuid())
  name         String        @unique
  price        Int
  active       Boolean       @default(true)
  participants Participant[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("tent_types")
}

model Participant {
  id                   String            @id @default(cuid())
  registrationNumber   String            @unique @map("registration_number")
  fullName             String            @map("full_name")
  gender               Gender
  birthDate            DateTime          @map("birth_date")
  phone                String            @unique
  whatsapp             String            @unique
  email                String            @unique
  church               String
  isMemberTibl         Boolean           @map("is_member_tibl")
  baptized             Boolean           @default(false) @map("baptized")
  allergicTo           String            @default("") @map("allergic_to")
  firstTime            Boolean           @map("first_time")
  maritalStatus        MaritalStatus?    @map("marital_status")
  bringingChildren     Boolean           @default(false) @map("bringing_children")
  numberOfChildren     Int               @default(0) @map("number_of_children")
  transportRequired    Boolean           @map("transport_required")
  transportStopId      String?           @map("transport_stop_id")
  transportStop        TransportStop?    @relation(fields: [transportStopId], references: [id])
  ownTransportType     OwnTransportType? @map("own_transport_type")
  carSeats             Int?              @map("car_seats")
  carRouteStops        String?           @map("car_route_stops")
  tentRequired         Boolean           @map("tent_required")
  mattressRequired     Boolean           @map("mattress_required")
  tentsCanProvide      Int               @default(0) @map("tents_can_provide")
  mattressesCanProvide Int               @default(0) @map("mattresses_can_provide")
  wantsToBuyTent       Boolean           @default(false) @map("wants_to_buy_tent")
  tentPurchaseTypeId   String?           @map("tent_purchase_type_id")
  tentPurchaseType     TentType?         @relation(fields: [tentPurchaseTypeId], references: [id])
  tentPurchaseQuantity Int               @default(0) @map("tent_purchase_quantity")
  isSponsored          Boolean           @default(false) @map("is_sponsored")
  paymentAmount        Int               @map("payment_amount")
  paymentProofPath     String?           @map("payment_proof_path")
  paymentStatus        PaymentStatus     @default(PENDING) @map("payment_status")
  paymentReviewedById  String?           @map("payment_reviewed_by_id")
  paymentReviewedBy    User?             @relation("PaymentReviewer", fields: [paymentReviewedById], references: [id])
  paymentReviewedAt    DateTime?         @map("payment_reviewed_at")
  qrToken              String            @unique @map("qr_token")
  checkedIn            Boolean           @default(false) @map("checked_in")
  checkedInAt          DateTime?         @map("checked_in_at")
  checkedInById        String?           @map("checked_in_by_id")
  checkedInBy          User?             @relation("CheckInOperator", fields: [checkedInById], references: [id])
  belongings           String?           @map("belongings")
  registeredByAdminId  String?           @map("registered_by_admin_id")
  registeredByAdmin    User?             @relation("ManualRegistration", fields: [registeredByAdminId], references: [id])
  deletedAt            DateTime?         @map("deleted_at")
  checkIn              CheckIn?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@index([fullName])
  @@index([church])
  @@index([checkedIn])
  @@index([deletedAt])
  @@map("participants")
}

model User {
  id                    String        @id @default(cuid())
  name                  String
  email                 String        @unique
  passwordHash          String        @map("password_hash")
  role                  Role
  checkIns              CheckIn[]
  checkedInParticipants Participant[] @relation("CheckInOperator")
  paymentReviews        Participant[] @relation("PaymentReviewer")
  manualRegistrations   Participant[] @relation("ManualRegistration")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model CheckIn {
  id            String      @id @default(cuid())
  participantId String      @unique @map("participant_id")
  participant   Participant @relation(fields: [participantId], references: [id])
  operatorId    String      @map("operator_id")
  operator      User        @relation(fields: [operatorId], references: [id])
  checkedInAt   DateTime    @default(now()) @map("checked_in_at")

  @@map("check_ins")
}
