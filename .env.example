# Copie estas variáveis para o ficheiro .env correto de cada workspace:
#
#   - raiz do repositório (.env): DATABASE_URL + SEED_ADMIN_* (usadas pelo Prisma CLI e por `npm run db:seed`)
#   - apps/api/.env: DATABASE_URL, JWT_*, PORT, WEB_ORIGIN, SEED_ADMIN_* (usadas em runtime pelo NestJS)
#   - apps/web/.env.local: NEXT_PUBLIC_API_URL

# Base de dados
DATABASE_URL="postgresql://dunamis:dunamis@localhost:5432/dunamis?schema=public"

# API (apps/api)
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
SEED_ADMIN_NAME="Administrador DUNAMIS"
SEED_ADMIN_EMAIL="admin@dunamis.local"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# Comprovativos de pagamento (apps/api) — opcional.
# Sem estas, os comprovativos são guardados em apps/api/uploads/ (disco local,
# perdido a cada redeploy em produção). Defina-as em produção para os guardar
# de forma persistente no Supabase Storage.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="payment-proofs"

# Email de validação de pagamento (apps/api) — opcional.
# Sem estas, os emails de confirmação/rejeição de pagamento não são enviados
# (apenas um aviso é escrito nos logs). Envio via API HTTPS da Brevo
# (app.brevo.com) — não SMTP direto, porque muitos hosts gratuitos (incluindo
# o Render) bloqueiam saída pela porta SMTP. Crie uma conta grátis, verifique
# o email remetente em Contacts > Senders, e gere uma API key em
# Settings > SMTP & API > API Keys.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""

# Web (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3001"
